{
  "private": true,
  "scripts": {
    "build": "NODE_COMMIT=$(git rev-parse HEAD) bun --bun nitro build",
    "dev": "bun --bun nitro dev",
    "prepare": "bun --bun nitro prepare",
    "preview": "bun --bun .output/server/index.mjs",
    "docker:start": "scripts/docker-start.bat",
    "docker:start:sh": "scripts/docker-start.sh",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "db:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/db/*.integration.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.1",
    "file-type": "^20.5.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.1",
    "sharp": "^0.34.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.1.0",
    "@eslint/js": "^9.39.2",
    "@testcontainers/mysql": "^11.11.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.7",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "nitropack": "latest",
    "testcontainers": "^11.11.0",
    "vitest": "^4.0.17"
  }
}
