# Development environment variables for Docker Compose
# Copy this to .env and it will work with docker-compose.dev.yml

NITRO_PUBLIC_API_URL=http://localhost:3000

NITRO_DATABASE_DEFAULT_OPTIONS_HOST=127.0.0.1
NITRO_DATABASE_DEFAULT_OPTIONS_PORT=3306
NITRO_DATABASE_DEFAULT_OPTIONS_USER=root
NITRO_DATABASE_DEFAULT_OPTIONS_PASSWORD=devpassword
NITRO_DATABASE_DEFAULT_OPTIONS_DATABASE=mydb

NITRO_DATABASE_STATES_OPTIONS_HOST=127.0.0.1
NITRO_DATABASE_STATES_OPTIONS_PORT=3306
NITRO_DATABASE_STATES_OPTIONS_USER=root
NITRO_DATABASE_STATES_OPTIONS_PASSWORD=devpassword
NITRO_DATABASE_STATES_OPTIONS_DATABASE=states

NITRO_DATABASE_BANLIST_OPTIONS_HOST=127.0.0.1
NITRO_DATABASE_BANLIST_OPTIONS_PORT=3306
NITRO_DATABASE_BANLIST_OPTIONS_USER=root
NITRO_DATABASE_BANLIST_OPTIONS_PASSWORD=devpassword
NITRO_DATABASE_BANLIST_OPTIONS_DATABASE=bans

NITRO_DATABASE_FORMS_OPTIONS_HOST=127.0.0.1
NITRO_DATABASE_FORMS_OPTIONS_PORT=3306
NITRO_DATABASE_FORMS_OPTIONS_USER=root
NITRO_DATABASE_FORMS_OPTIONS_PASSWORD=devpassword
NITRO_DATABASE_FORMS_OPTIONS_DATABASE=forms

NITRO_DATABASE_DEBUG=false

NITRO_JWT_SECRET=dev-jwt-secret
NITRO_UPLOAD_DIR=uploads
NITRO_SQLITE_SKIN_PATH=data/sqlite.db

NITRO_TELEGRAM_BOT_TOKEN=dev_bot_token
NITRO_TELEGRAM_CHAT_ID=dev_chat_id
NITRO_TELEGRAM_THREAD_ID=dev_thread_id
NITRO_TELEGRAM_TOPIC_SKINS=dev_topic_skins
