{
  "name": "@helicraft/antares",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file=../../.env src/index.ts",
    "start": "bun dist/index.js",
    "build": "bun build src/index.ts --target=bun --outdir=dist --packages=external",
    "typecheck": "bunx --bun tsc --noEmit",
    "test": "bunx --bun vitest run",
    "test:integration": "bunx --bun vitest run --config vitest.integration.config.ts",
    "openapi": "bun scripts/openapi.ts",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env scripts/migrate.ts",
    "db:studio": "bunx --bun drizzle-kit studio",
    "admin:bootstrap-owner": "bun --env-file=../../.env scripts/bootstrap-owner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@hono/zod-openapi": "1.6.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "pg": "8.23.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/bun": "1.4.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "testcontainers": "12.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
