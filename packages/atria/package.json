{
  "name": "@helicraft/atria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.scss": "./src/styles.scss"
  },
  "scripts": {
    "dev": "bunx --bun vite build --watch",
    "build": "bunx --bun vite build && bunx --bun tsc -p tsconfig.build.json",
    "typecheck": "bunx --bun tsc --noEmit",
    "test": "bunx --bun vitest run",
    "storybook": "bunx --bun storybook dev -p 6006 --no-open",
    "build:storybook": "bunx --bun storybook build"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "1.105.1",
    "storybook": "10.6.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
