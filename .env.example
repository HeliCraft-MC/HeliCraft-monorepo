# Local development only. Replace credentials before external deployment.
POSTGRES_PASSWORD=helicraft
DATABASE_URL=postgresql://helicraft:helicraft@localhost:5432/helicraft
PORT=3000
API_PROXY_TARGET=http://localhost:3000
# Exact browser origin, without trailing slash. Production: HTTPS domain and SECURE_COOKIES=true.
SITE_ORIGIN=http://localhost:5173
SECURE_COOKIES=false
REGISTRATION_ENABLED=true
SITE_PHASE=PRELAUNCH
# Optional actual community/source links: JSON array of label and HTTP(S) url; no placeholders.
COMMUNITY_LINKS=[]
# Optional real server address; shown only with SITE_PHASE=OPEN.
MINECRAFT_ADDRESS=
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=helicraftdev
S3_SECRET_KEY=helicraftdevsecret
S3_BUCKET=helicraft
# Replace with a random alphanumeric string shared by Paper and Velocity.
FORWARDING_SECRET=ReplaceWithRandomAlphanumericSecretBeforeDeployment
# Set true only after accepting https://aka.ms/MinecraftEULA
EULA=false
WEB_BIND=127.0.0.1
WEB_PORT=8080
MINECRAFT_BIND=0.0.0.0
MINECRAFT_PORT=25565
DENEB_MEMORY=2G
RIGEL_MEMORY=512M
