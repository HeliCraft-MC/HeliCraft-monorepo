# Disposable environment only. minecraft:prepare generates private random values in run/.env.
MC_TEST_DATABASE_PASSWORD=
MC_TEST_STORAGE_SECRET=
MC_TEST_RIGEL_TOKEN=
MC_TEST_DENEB_TOKEN=
MC_TEST_FORWARDING_SECRET=

# Plugin request timeout is bounded to 1000..10000 ms. Mutation retry is disabled.
MINECRAFT_HTTP_TIMEOUT_MS=4000
