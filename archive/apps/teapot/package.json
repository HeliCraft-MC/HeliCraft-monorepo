{
    "type": "module",
    "private": true,
    "packageManager": "bun@1.4.2",
    "scripts": {
        "build": "NODE_COMMIT_TEAPOT=$(git rev-parse HEAD) bun --bun nitro build",
        "dev": "bun --bun nitro dev",
        "prepare": "bun --bun nitro prepare",
        "preview": "bun --bun .output/server/index.mjs",
        "docker:start": "scripts/docker-start.bat",
        "docker:start:sh": "scripts/docker-start.sh",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:push:forms": "DRIZZLE_DATABASE=forms drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:dev": "docker-compose -f docker-compose.dev.yml up -d",
        "db:dev:down": "docker-compose -f docker-compose.dev.yml down",
        "test": "bun --bun vitest run --exclude 'tests/db/*.integration.test.ts' --exclude 'tests/api/*.test.ts'",
        "test:watch": "bun --bun vitest --exclude 'tests/db/*.integration.test.ts' --exclude 'tests/api/*.test.ts'",
        "test:integration": "bun --bun vitest run tests/db/*.integration.test.ts",
        "test:api": "bun --bun vitest run tests/api/*.api.test.ts",
        "test:all": "bun scripts/test-all.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "drizzle-orm": "^0.45.3",
        "file-type": "^22.1.1",
        "jsonwebtoken": "^9.0.3",
        "mysql2": "^3.24.4",
        "ofetch": "^1.5.1",
        "sharp": "^0.35.5",
        "uuid": "^14.0.2"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.5.1",
        "@eslint/js": "^10.0.1",
        "@testcontainers/mysql": "^12.2.0",
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^3.0.0",
        "@types/bun": "^1.4.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.3",
        "@types/supertest": "^7.2.1",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.11.0",
        "nitropack": "^2.13.4",
        "supertest": "^7.3.0",
        "testcontainers": "^12.2.0",
        "typescript": "^5.9.3",
        "vitest": "^5.0.2"
    },
    "overrides": {
        "@grpc/grpc-js": "^1.14.5",
        "@humanfs/node": "^0.16.8",
        "brace-expansion@<2": "1.1.21",
        "brace-expansion@>=2 <3": "2.1.7",
        "defu": "^6.1.7",
        "form-data": "^4.0.6",
        "lodash": "^4.18.1",
        "minimatch@<4": "3.1.5",
        "minimatch@>=5 <6": "5.1.9",
        "minimatch@>=9 <10": "9.0.9",
        "picomatch@<3": "2.3.2",
        "postcss": "^8.5.28",
        "protobufjs": "^7.6.6",
        "qs": "^6.16.0",
        "tar": "^7.5.22"
    }
}
