{
  "name": "helicraft",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/vega",
    "apps/antares",
    "packages/atria",
    "packages/alhena"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts all",
    "dev:vega": "bun scripts/dev.ts vega",
    "dev:antares": "bun scripts/dev.ts antares",
    "dev:atria": "bun run --cwd packages/atria dev",
    "dev:alhena": "bun run --cwd packages/alhena dev",
    "dev:deneb": "bun scripts/java.ts dev deneb",
    "dev:rigel": "bun scripts/java.ts dev rigel",
    "generate": "bun run --cwd apps/antares openapi && bun run --cwd packages/alhena generate",
    "build:packages": "bun run generate && bun run --cwd packages/alhena build && bun run --cwd packages/atria build",
    "build:ts": "bun run build:packages && bun run --cwd apps/antares build && bun run --cwd apps/vega build",
    "build:java": "bun scripts/java.ts build all",
    "build": "bun run build:ts",
    "typecheck": "bun run generate && bun node_modules/typescript/bin/tsc --noEmit && bun run --filter \"@helicraft/*\" typecheck",
    "lint": "bun run lint:ts",
    "test": "bun run test:unit",
    "test:unit": "bun run generate && bun run --filter \"@helicraft/*\" test",
    "test:java": "bun scripts/java.ts test all",
    "test:integration": "bun run --cwd apps/antares test:integration",
    "test:e2e": "bun run build:ts && bunx --bun playwright test",
    "storybook": "bun run --cwd packages/atria storybook",
    "build:storybook": "bun run --cwd packages/atria build:storybook",
    "infra:up": "docker compose -f compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f compose.dev.yml down",
    "compose:up": "docker compose up -d --build --wait vega",
    "compose:down": "docker compose down",
    "db:generate": "bun run --cwd apps/antares db:generate",
    "db:migrate": "bun run --cwd apps/antares db:migrate",
    "build:vega": "bun run --cwd apps/vega build",
    "test:vega": "bun run --cwd apps/vega test",
    "build:antares": "bun run --cwd apps/antares build",
    "test:antares": "bun run --cwd apps/antares test",
    "build:atria": "bun run --cwd packages/atria build",
    "test:atria": "bun run --cwd packages/atria test",
    "build:alhena": "bun run --cwd packages/alhena build",
    "test:alhena": "bun run --cwd packages/alhena test",
    "build:deneb": "bun scripts/java.ts build deneb",
    "test:deneb": "bun scripts/java.ts test deneb",
    "build:rigel": "bun scripts/java.ts build rigel",
    "test:rigel": "bun scripts/java.ts test rigel",
    "lint:ts": "bunx --bun oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "bunx --bun oxlint --type-aware --fix .",
    "lint:java": "bun scripts/java.ts lint all",
    "format": "bun run format:ts",
    "format:ts": "bunx --bun oxfmt .",
    "format:java": "bun scripts/java.ts format all",
    "format:check": "bun run format:check:ts",
    "format:check:ts": "bunx --bun oxfmt --check .",
    "format:check:java": "bun scripts/java.ts format-check all",
    "admin:bootstrap-owner": "bun run --cwd apps/antares admin:bootstrap-owner"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
